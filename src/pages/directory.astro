---
import Layout from "../layouts/MainLayout.astro";

const base = import.meta.env.BASE_URL;
---

<Layout>
    <div class="bg-white p-6 md:p-8 rounded-lg shadow-lg">
        <h2 class="text-3xl font-bold text-gray-800 mb-6">Section J Directory</h2>
        <div id="directory-container" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <p class="text-gray-600">Loading directory...</p>
        </div>
    </div>

    <script define:vars={{ base }}>
        const SPREADSHEET_ID = "1fTnSw2wZYzWLAa9jT0FA26oeSl5SUSKpgrRf0z_U9c4";
        const DIRECTORY_SHEET_GID = "1897311902";
        const JSON_URL = `https://docs.google.com/spreadsheets/d/${SPREADSHEET_ID}/gviz/tq?tqx=out:json&gid=${DIRECTORY_SHEET_GID}`;
        const container = document.getElementById("directory-container");

        function escapeHtml(value) {
            return String(value ?? "").replace(/[&<>'"]/g, (character) => ({
                "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;",
            })[character]);
        }

        async function loadDirectory() {
            try {
                const response = await fetch(JSON_URL);
                if (!response.ok) throw new Error("Network response was not ok");
                const text = await response.text();
                const data = JSON.parse(text.substring(47, text.length - 2));
                const members = data.table.rows.map((row) => ({
                    personId: row.c[0]?.v,
                    name: row.c[1]?.v,
                    imageFile: row.c[2]?.v,
                })).filter((member) => member.personId && member.name && member.imageFile);

                if (!members.length) throw new Error("No directory members found");

                container.innerHTML = members.map((member) => {
                    const name = escapeHtml(member.name);
                    const imageUrl = `${base}assets/hbs_classcard_photos/${encodeURIComponent(member.imageFile)}`;
                    const profileUrl = `${base}directory/${encodeURIComponent(member.personId)}`;
                    return `<a href="${profileUrl}" data-person-id="${escapeHtml(member.personId)}" class="block bg-white p-4 rounded-lg shadow-sm border border-gray-200 hover:shadow-md hover:border-hbs-crimson transition"><div class="flex flex-col items-center"><img src="${imageUrl}" alt="${name}" class="w-24 h-24 rounded-full object-cover mb-3" /><h3 class="text-lg font-semibold text-gray-900 text-center">${name}</h3></div></a>`;
                }).join("");
            } catch (error) {
                console.error("Error fetching directory:", error);
                container.innerHTML = '<p class="text-red-600">Failed to load the directory. Please try refreshing the page.</p>';
            }
        }

        loadDirectory();
    </script>
</Layout>
