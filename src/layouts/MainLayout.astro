---
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
const normalize = (path: string) => path.replace(/\/+$/, "");
const isActive = (path: string) =>
    normalize(Astro.url.pathname) === normalize(base + path);
const SHEET_URL =
    "https://docs.google.com/spreadsheets/d/1fTnSw2wZYzWLAa9jT0FA26oeSl5SUSKpgrRf0z_U9c4/edit?gid=2002002496#gid=2002002496";
const navLinkClass = (active: boolean) =>
    `py-4 px-1 border-b-4 text-sm md:text-base font-medium ${
        active
            ? "text-hbs-crimson border-hbs-crimson"
            : "text-gray-600 border-transparent hover:text-gray-800 hover:border-gray-300"
    }`;
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>HBS Class of 2027 - Section J</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
        <link href={base + "favicon.ico"} rel="icon" type="image/x-icon" />
    </head>
    <body class="bg-gray-100">
        <div class="min-h-screen">
            <header class="bg-hbs-crimson text-white shadow-lg">
                <div class="container mx-auto px-6 py-6 flex justify-between items-center">
                    <h1 class="text-2xl md:text-3xl font-bold tracking-tight">
                        Section J
                        <span class="block text-lg md:inline md:ml-2 font-light opacity-90">HBS Class of 2027</span>
                    </h1>
                    <div class="hidden md:block">
                        <img src={base + "assets/hbs_w.png"} alt="HBS logo" class="w-12 h-12" />
                    </div>
                </div>
            </header>

            <nav class="bg-white shadow-md sticky top-0 z-10">
                <div class="container mx-auto px-6">
                    <div class="flex space-x-6 md:space-x-8 -mb-px overflow-x-auto md:overflow-visible whitespace-nowrap">
                        <a href={base} class={navLinkClass(isActive("") || isActive("home"))}>Home</a>
                        <a href={base + "directory"} class={navLinkClass(isActive("directory"))}>Directory</a>
                        <a href={base + "map"} class={navLinkClass(isActive("map"))}>Map</a>
                        <a
                            href={SHEET_URL}
                            target="_blank"
                            rel="noopener noreferrer"
                            class={navLinkClass(false)}
                        >
                            Database
                        </a>
                    </div>
                </div>
            </nav>

            <main class="container mx-auto p-4 md:p-8"><slot /></main>
        </div>

        <footer class="bg-gray-800 text-gray-400 p-8 mt-12">
            <div class="container mx-auto text-center">
                <p>&copy; 2025 HBS Section J, Class of 2027. All Rights Reserved.</p>
                <p class="text-sm mt-2">This site is managed by the Section J Leadership Team.</p>
                <p class="text-sm mt-3">
                    <a
                        href={SHEET_URL}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-gray-300 underline hover:text-white"
                    >
                        Section J Database
                    </a>
                </p>
            </div>
        </footer>
    </body>
</html>
